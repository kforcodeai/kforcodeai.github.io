---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SectionHead from '../components/SectionHead.astro';
import { AUTHOR } from '../consts';

const description =
	'Kaushal Prajapati advises teams building AI products — agent platforms, retrieval and RAG quality, evals and release gates, Document AI, and LLM cost engineering.';

const services = [
	{
		net: 'SVC::01',
		title: 'Agent platforms & runtimes',
		body: 'Architecture and review for agent harnesses, tool authorization, memory, orchestration, and MCP developer platforms — the runtime layer your AI products stand on.',
		proof: '15M+ conversations / quarter on the runtime I architected',
	},
	{
		net: 'SVC::02',
		title: 'Retrieval & RAG quality',
		body: 'Diagnosing and fixing retrieval: hybrid search, reranking, layout-aware chunking, citation grounding, and document question answering that holds up under audit.',
		proof: 'Evidence retrieval F1@10 raised from 86% to 97%',
	},
	{
		net: 'SVC::03',
		title: 'Evals & release gates',
		body: 'Evaluation suites that gate releases: faithfulness, citation accuracy, hallucination rate, synthetic data with hard negatives, and regression harnesses your team can run on every change.',
		proof: 'Release gates that kept an enterprise compliance product shippable',
	},
	{
		net: 'SVC::04',
		title: 'Document AI & cost engineering',
		body: 'Intelligent document processing, OCR routing, fine-tuning small models with LoRA/QLoRA, and cost-aware routing between open models and frontier APIs.',
		proof: '70% OCR cost reduction · 23+ legacy pipelines replaced by one model',
	},
];

const engagements = [
	{
		net: 'CALL::01',
		name: 'Advisory session',
		duration: '60–90 minutes',
		body: 'A focused working session to unblock one decision: an architecture call, an eval strategy, a build-vs-buy question, a retrieval-quality diagnosis. You leave with a concrete recommendation and next steps.',
	},
	{
		net: 'SPRINT::02',
		name: 'Architecture & quality review',
		duration: '1–2 weeks',
		body: 'A deep dive into an existing system — agent runtime review, retrieval audit, eval-gap analysis — ending in a written, prioritized report your team can execute without me.',
	},
	{
		net: 'RETAINER::03',
		name: 'Ongoing advisory',
		duration: 'monthly',
		body: 'Recurring access for teams building AI platforms: design reviews, roadmap input, eval and quality checkpoints, and help hiring and leveling up AI engineers.',
	},
];

const cases = [
	{
		net: 'CASE::01',
		title: 'Evidence retrieval, 86% → 97%',
		body: 'How a retrieval overhaul prevented churn of an enterprise compliance client.',
		href: '/blog/evidence-retrieval-86-to-97/',
	},
	{
		net: 'CASE::02',
		title: 'One model instead of 23',
		body: 'Replacing 23+ legacy extraction pipelines with a single layout-aware model.',
		href: '/blog/one-model-instead-of-23/',
	},
	{
		net: 'CASE::03',
		title: 'The system layer behind AI products',
		body: 'The runtime architecture carrying 15M+ conversations a quarter.',
		href: '/blog/the-system-layer-behind-ai-products/',
	},
];

const faqs = [
	{
		q: 'What kinds of teams do you work with?',
		a: 'Teams shipping LLM products — from seed-stage startups to enterprise platform groups. The strongest fit is anyone building agents, retrieval/RAG, document intelligence, or the eval infrastructure around them.',
	},
	{
		q: 'Do you write code or only advise?',
		a: 'Both, depending on the engagement. Advisory sessions and reviews produce written recommendations, architecture diagrams, and eval designs. Scoped sprints can include hands-on prototyping and reference implementations.',
	},
	{
		q: 'How do fees work?',
		a: 'Fixed per engagement, agreed before work starts — after a free intro call to confirm fit and scope. No open-ended hourly billing.',
	},
	{
		q: 'Can you help us hire or level up our AI team?',
		a: 'Yes. Interview loops, evaluation rubrics for AI engineering roles, and mentoring for engineers moving from ML models into AI systems work.',
	},
	{
		q: 'Are you available for full-time roles?',
		a: 'For Staff/Principal AI platform roles, see the about page for my full track record, then reach out by email or LinkedIn.',
	},
];

const serviceLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'AI engineering consulting by Kaushal Prajapati',
	serviceType: 'AI engineering consulting',
	description,
	url: `${AUTHOR.site}/consulting/`,
	provider: {
		'@type': 'Person',
		name: AUTHOR.name,
		alternateName: AUTHOR.handle,
		jobTitle: AUTHOR.role,
		url: AUTHOR.site,
		sameAs: [AUTHOR.github, AUTHOR.linkedin],
	},
	areaServed: 'Worldwide',
	availableChannel: {
		'@type': 'ServiceChannel',
		serviceUrl: AUTHOR.calendly,
		availableLanguage: 'en',
	},
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Consulting engagements',
		itemListElement: engagements.map((e) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: e.name, description: e.body },
		})),
	},
};

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const inquiryHref = `mailto:${AUTHOR.email}?subject=${encodeURIComponent('Consulting inquiry')}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Consulting · Kaushal Prajapati — AI Platforms, RAG & Evals" description={description} ogImage="/og/consulting.png" />
		<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class="page-head">
				<div class="prompt net"><span>~/kforcode</span>$ open --channel=consulting</div>
				<h1>Ship production-grade AI.</h1>
				<p class="intro">
					I advise teams on the layer between a promising demo and a reliable product: agent
					platforms, retrieval quality, evals, and LLM cost. The same problems I solve at
					production scale — brought to your system.
				</p>
				<div class="quick-meta">
					<span><i class="dot"></i> Independent advisory</span><span>remote</span><span>US / India hours</span>
				</div>
				<div class="head-actions">
					<a class="btn" href={AUTHOR.calendly} target="_blank" rel="noopener">book an intro call ↗</a>
					<a class="btn ghost" href={inquiryHref}>email an inquiry</a>
					<a class="btn ghost" href={AUTHOR.linkedin} target="_blank" rel="me noopener">linkedin ↗</a>
				</div>
			</header>

			<section class="services">
				<SectionHead net="what_i_help_with" />
				<div class="service-grid">
					{services.map((s) => (
						<div class="service node">
							<span class="net">{s.net}</span>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
							<strong class="net">{s.proof}</strong>
						</div>
					))}
				</div>
			</section>

			<section class="engagements">
				<SectionHead net="engagement_models" />
				<div class="two-col">
					<div>
						<h2>Three ways to work together.</h2>
						<p>
							Every engagement starts with a free 20-minute intro call — {' '}
							<a href={AUTHOR.calendly} target="_blank" rel="noopener">book one directly</a>.
							You describe the system and the problem, and we decide together whether I'm the
							right person. Fees are fixed and scoped before work begins.
						</p>
					</div>
					<ol class="engagement-list">
						{engagements.map((e) => (
							<li>
								<div class="engagement-meta net"><span>{e.net}</span><span>{e.duration}</span></div>
								<div>
									<h3>{e.name}</h3>
									<p>{e.body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="cases">
				<SectionHead net="case_files" href="/blog" label="all writing" />
				<div class="case-grid">
					{cases.map((c) => (
						<a class="case node" href={c.href}>
							<span class="net">{c.net}</span>
							<strong>{c.title}</strong>
							<small>{c.body}</small>
							<i class="net">read the case →</i>
						</a>
					))}
				</div>
			</section>

			<section class="faq">
				<SectionHead net="faq" />
				<div class="faq-list">
					{faqs.map((f, i) => (
						<details class="faq-item">
							<summary>
								<span class="net">Q::{String(i + 1).padStart(2, '0')}</span>
								<strong>{f.q}</strong>
								<span class="faq-toggle" aria-hidden="true"></span>
							</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>

			<section class="contact">
				<div>
					<span class="net">open_channel</span>
					<h2>Tell me what you're building.</h2>
					<p>
						Two or three sentences about your system and where it hurts is enough. I reply to
						every serious inquiry, usually within two working days.
					</p>
				</div>
				<div class="contact-links">
					<a class="btn" href={AUTHOR.calendly} target="_blank" rel="noopener">book an intro call ↗</a>
					<a class="btn ghost" href={inquiryHref}>email an inquiry</a>
					<a class="btn ghost" href={AUTHOR.linkedin} target="_blank" rel="me noopener">linkedin ↗</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		margin-top: 5rem;
	}

	.page-head {
		max-width: 820px;
		padding: 2.5rem 0 1rem;
	}

	.prompt {
		margin-bottom: 1rem;
		text-transform: none;
	}

	.prompt span {
		color: var(--accent);
	}

	.page-head h1 {
		font-size: clamp(2.8rem, 6vw, 4.6rem);
	}

	.intro {
		max-width: 720px;
		margin: 1.5rem 0 0;
		color: var(--ink-soft);
		font-size: 1.12rem;
	}

	.quick-meta {
		display: flex;
		gap: 0.65rem 1.2rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.quick-meta span {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.head-actions {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.service {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.4rem;
	}

	.service h3 {
		font-size: 1.12rem;
	}

	.service p {
		margin: 0;
		color: var(--muted);
		font-size: 0.88rem;
		flex: 1;
	}

	.service > strong {
		color: var(--accent);
		font-weight: 500;
		text-transform: none;
	}

	.two-col {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: 5rem;
		align-items: start;
	}

	.two-col h2 {
		font-size: 2rem;
		line-height: 1.2;
	}

	.two-col > div > p {
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.94rem;
	}

	.engagement-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.engagement-list li {
		display: grid;
		grid-template-columns: 130px minmax(0, 1fr);
		gap: 2rem;
		padding: 1.4rem 0;
		border-top: 1px solid var(--line);
	}

	.engagement-list li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.engagement-meta {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.68rem;
	}

	.engagement-meta span:first-child {
		color: var(--accent);
	}

	.engagement-list h3 {
		font-size: 1.1rem;
	}

	.engagement-list li p {
		max-width: 640px;
		margin: 0.55rem 0 0;
		color: var(--muted);
		font-size: 0.88rem;
	}

	.case-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.case {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.3rem;
	}

	.case > strong {
		font-family: var(--font-display);
		font-size: 1.02rem;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.case > small {
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.55;
		flex: 1;
	}

	.case > i {
		color: var(--muted);
		font-style: normal;
		transition: color 0.15s var(--ease);
	}

	.case:hover > i,
	.case:hover > strong {
		color: var(--accent);
	}

	.faq-list {
		border-top: 1px solid var(--line);
	}

	.faq-item {
		border-bottom: 1px solid var(--line);
	}

	.faq-item summary {
		display: grid;
		grid-template-columns: 62px minmax(0, 1fr) 20px;
		gap: 1.1rem;
		align-items: center;
		padding: 1.15rem 0;
		cursor: pointer;
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary .net {
		color: var(--accent);
	}

	.faq-item summary strong {
		font-size: 0.95rem;
		font-weight: 600;
		transition: color 0.15s var(--ease);
	}

	.faq-item summary:hover strong,
	.faq-item[open] summary strong {
		color: var(--accent);
	}

	.faq-toggle {
		position: relative;
		width: 18px;
		height: 18px;
	}

	.faq-toggle::before,
	.faq-toggle::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 12px;
		height: 1px;
		background: var(--muted);
		transform: translate(-50%, -50%);
		transition: transform 0.15s var(--ease);
	}

	.faq-toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.faq-item[open] .faq-toggle::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	.faq-item > p {
		max-width: 720px;
		margin: 0;
		padding: 0 0 1.3rem 78px;
		color: var(--muted);
		font-size: 0.88rem;
	}

	.contact {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--bg-panel);
	}

	.contact h2 {
		margin-top: 0.5rem;
		font-size: 1.55rem;
	}

	.contact p {
		max-width: 620px;
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.84rem;
	}

	.contact-links {
		display: flex;
		gap: 0.55rem;
		flex: none;
		flex-wrap: wrap;
	}

	@media (max-width: 720px) {
		.page-head {
			padding-top: 1rem;
		}

		.service-grid,
		.case-grid {
			grid-template-columns: 1fr;
		}

		.two-col {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.engagement-list li {
			grid-template-columns: 1fr;
			gap: 0.7rem;
		}

		.engagement-meta {
			flex-direction: row;
			justify-content: space-between;
		}

		.faq-item summary {
			grid-template-columns: minmax(0, 1fr) 20px;
		}

		.faq-item summary .net {
			display: none;
		}

		.faq-item > p {
			padding-left: 0;
		}

		.contact {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
