---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { AUTHOR, PAPERS, SITE_DESCRIPTION, SITE_TITLE, TOPICS } from '../consts';
import { byDateDesc } from '../lib/utils';

const posts = (await getCollection('blog')).sort(byDateDesc);

const homepageLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	name: `${AUTHOR.name} — AI systems engineer and writer`,
	description: SITE_DESCRIPTION,
	url: AUTHOR.site,
	mainEntity: {
		'@type': 'Person',
		name: AUTHOR.name,
		alternateName: AUTHOR.handle,
		jobTitle: AUTHOR.role,
		url: AUTHOR.site,
		sameAs: [AUTHOR.github, AUTHOR.linkedin],
	},
};

const writingLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Latest writing by Kaushal Prajapati',
	itemListElement: posts.slice(0, 5).map((post, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		url: `${AUTHOR.site}/blog/${post.id}/`,
		name: post.data.title,
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} · Production AI Systems & Research`} description={SITE_DESCRIPTION} ogImage="/og/home.png" />
		<script type="application/ld+json" set:html={JSON.stringify(homepageLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(writingLd)} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="hero">
				<div class="prompt net"><span>kaushal@kforcode</span>:~$ whoami</div>
				<h1>Engineering AI systems built for production.</h1>
				<p class="lede">
					I’m Kaushal, a Staff AI/ML Engineer. I build agent runtimes, evaluation systems,
					retrieval infrastructure, and developer platforms—and write about what actually works.
				</p>
				<div class="status-line">
					<span><i class="dot"></i> Building at HighLevel</span>
					<span>8+ years in applied AI</span>
					<span>{PAPERS.length} peer-reviewed papers</span>
				</div>
				<div class="hero-actions">
					<a class="btn" href="/blog">read the writing →</a>
					<a class="btn ghost" href="/consulting">work with me</a>
					<a class="btn ghost" href="/about">about me</a>
				</div>
			</section>

			<section class="fig">
				<SectionHead net="FIG.01 · the_system_layer" />
				<figure>
					<div class="fig-scroll">
						<svg
							viewBox="0 0 920 252"
							role="img"
							aria-label="Architecture diagram: six product surfaces connect to one unified AI runtime handling model routing, tool authorization, memory, and provider fallback, gated by evals — which connects out to model providers and 600+ tool operations over MCP."
						>
							<defs>
								<marker id="fig-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
									<path class="s-arr" d="M0 0L8 4L0 8z"></path>
								</marker>
							</defs>

							<text class="s-g" x="8" y="14">surfaces · 6+</text>
							<rect class="s-box" x="8" y="26" width="168" height="34" rx="5"></rect>
							<text class="s-t" x="24" y="47.5">voice_ai</text>
							<rect class="s-box" x="8" y="70" width="168" height="34" rx="5"></rect>
							<text class="s-t" x="24" y="91.5">conversation_ai</text>
							<rect class="s-box" x="8" y="114" width="168" height="34" rx="5"></rect>
							<text class="s-t" x="24" y="135.5">agent_studio</text>
							<rect class="s-box" x="8" y="158" width="168" height="34" rx="5"></rect>
							<text class="s-t" x="24" y="179.5">ask_ai</text>
							<text class="s-sub" x="8" y="214">+ ads_copilot · email_agent</text>

							<path class="s-edge" marker-end="url(#fig-arr)" d="M176 43 C226 43 228 60 278 60"></path>
							<path class="s-edge" marker-end="url(#fig-arr)" d="M176 87 C226 87 228 88 278 88"></path>
							<path class="s-edge" marker-end="url(#fig-arr)" d="M176 131 C226 131 228 116 278 116"></path>
							<path class="s-edge" marker-end="url(#fig-arr)" d="M176 175 C226 175 228 144 278 144"></path>

							<text class="s-g" x="280" y="14">execution layer</text>
							<rect class="s-box s-box--accent" x="280" y="26" width="280" height="150" rx="6"></rect>
							<text class="s-title" x="420" y="54" text-anchor="middle">unified_ai_runtime</text>
							<line class="s-div" x1="296" y1="68" x2="544" y2="68"></line>
							<text class="s-sub" x="300" y="94">model_routing</text>
							<text class="s-sub" x="424" y="94">tool_authz</text>
							<text class="s-sub" x="300" y="118">memory</text>
							<text class="s-sub" x="424" y="118">provider_fallback</text>
							<circle class="s-dot" cx="305" cy="148" r="3.5"></circle>
							<text class="s-live" x="316" y="152">live · 99.9% success</text>

							<path class="s-edge s-dash" marker-end="url(#fig-arr)" d="M420 176 L420 206"></path>
							<rect class="s-box" x="330" y="206" width="180" height="34" rx="5"></rect>
							<text class="s-t" x="420" y="227.5" text-anchor="middle">evals · release_gates</text>

							<path class="s-edge" marker-end="url(#fig-arr)" d="M560 54 L674 54"></path>
							<path class="s-edge" marker-end="url(#fig-arr)" d="M560 148 L674 148"></path>

							<text class="s-g" x="676" y="14">capabilities</text>
							<rect class="s-box" x="676" y="26" width="236" height="56" rx="5"></rect>
							<text class="s-t" x="692" y="48">model_providers</text>
							<text class="s-sub" x="692" y="68">openai · anthropic · google</text>
							<rect class="s-box" x="676" y="120" width="236" height="56" rx="5"></rect>
							<text class="s-t" x="692" y="142">tools_over_mcp</text>
							<text class="s-sub" x="692" y="162">600+ operations</text>
						</svg>
					</div>
					<figcaption class="net">
						FIG.01 — the layer I build: one runtime between product surfaces and models — routing,
						tool authorization, memory, and evals in a single system.
					</figcaption>
				</figure>
			</section>

			<section class="writing">
				<SectionHead net="latest_writing" href="/blog" label="view archive" />
				<div>{posts.slice(0, 4).map((post, i) => <PostCard post={post} index={i + 1} variant="row" />)}</div>
			</section>

			<section class="work">
				<SectionHead net="working_set" />
				<div class="work-grid">
					<div class="work-copy">
						<h2>Systems thinking for applied AI.</h2>
						<p>
							I write for engineers, researchers, and technical leaders working where model behavior
							meets reliability, latency, cost, and product constraints.
						</p>
					</div>
					<nav class="topic-list" aria-label="Writing topics">
						{TOPICS.map((topic) => (
							<a href={topic.slug === 'papers' ? '/research/' : `/tags/${topic.slug}/`}>
								<span>{topic.label}</span><small>{topic.blurb}</small><i>→</i>
							</a>
						))}
					</nav>
				</div>

				<div class="metrics" aria-label="Selected impact">
					<div><strong>15M+</strong><span>conversations / quarter</span></div>
					<div><strong>800B+</strong><span>tokens / quarter</span></div>
					<div><strong>600+</strong><span>MCP operations</span></div>
					<div><strong>99.9%</strong><span>runtime success</span></div>
				</div>
			</section>

			<section class="research">
				<SectionHead net="selected_research" href="/research" label="all papers" />
				<div class="research-grid">
					<div>
						<h2>Research informed by real systems.</h2>
						<p>Peer-reviewed work on Document AI, privacy, clinical summarization, and efficient fine-tuning.</p>
					</div>
					<ol>
						{PAPERS.map((paper, i) => (
							<li><a href={paper.url} target="_blank" rel="noopener"><span class="net">0{i + 1} · {paper.year}</span><strong>{paper.title}</strong><small>{paper.venue} ↗</small></a></li>
						))}
					</ol>
				</div>
			</section>

			<section class="paths" aria-label="Work with me">
				<SectionHead net="open_channel" />
				<div class="path-grid">
					<a class="path node" href="/consulting/">
						<span class="net">FOR::TEAMS</span>
						<h2>Building AI products?</h2>
						<p>
							I consult on agent platforms, retrieval quality, evals, and LLM cost —
							advisory sessions, architecture reviews, and ongoing engagements.
						</p>
						<i class="net">work with me →</i>
					</a>
					<a class="path node" href="/about/">
						<span class="net">FOR::RECRUITERS</span>
						<h2>Hiring Staff+ AI engineers?</h2>
						<p>
							Eight years of production AI across four companies, three peer-reviewed
							papers, and the platform behind six AI product surfaces.
						</p>
						<i class="net">see the track record →</i>
					</a>
				</div>
				<div class="path-links">
					<a class="btn" href={`mailto:${AUTHOR.email}`}>email</a>
					<a class="btn ghost" href={AUTHOR.calendly} target="_blank" rel="noopener">book a call ↗</a>
					<a class="btn ghost" href={AUTHOR.linkedin} target="_blank" rel="me noopener">linkedin ↗</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		margin-bottom: 6rem;
	}

	.hero {
		max-width: 850px;
		padding: 4rem 0 2rem;
	}

	.prompt {
		margin-bottom: 1.4rem;
		text-transform: none;
	}

	.prompt span {
		color: var(--accent);
	}

	.hero h1 {
		max-width: 820px;
		font-size: clamp(3.2rem, 7vw, 5.6rem);
		line-height: 1.02;
	}

	.lede {
		max-width: 730px;
		margin: 1.5rem 0 0;
		color: var(--ink-soft);
		font-size: 1.2rem;
		line-height: 1.65;
	}

	.status-line {
		display: flex;
		gap: 0.7rem 1.2rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.status-line span {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.fig figure {
		margin: 0;
	}

	.fig-scroll {
		padding: 1.75rem 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--bg-panel);
		overflow-x: auto;
	}

	.fig-scroll svg {
		display: block;
		min-width: 780px;
		width: 100%;
		height: auto;
	}

	.fig svg text {
		font-family: var(--font-mono);
	}

	.s-g {
		font-size: 10px;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		fill: var(--muted);
	}

	.s-t {
		font-size: 11px;
		fill: var(--ink);
	}

	.s-title {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.05em;
		fill: var(--ink);
	}

	.s-sub {
		font-size: 10px;
		fill: var(--muted);
	}

	.s-live {
		font-size: 10px;
		fill: var(--accent);
	}

	.s-box {
		fill: var(--bg-inset);
		stroke: var(--line-strong);
	}

	.s-box--accent {
		stroke: var(--accent);
	}

	.s-dot {
		fill: var(--live);
	}

	.s-div {
		stroke: var(--line);
	}

	.s-edge {
		fill: none;
		stroke: var(--line-strong);
	}

	.s-dash {
		stroke-dasharray: 4 4;
	}

	.s-arr {
		fill: var(--line-strong);
	}

	.fig figcaption {
		max-width: 760px;
		margin-top: 0.85rem;
		text-transform: none;
	}

	.work-grid,
	.research-grid {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: 5rem;
		align-items: start;
	}

	.work-copy p,
	.research-grid > div p {
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.94rem;
	}

	.topic-list {
		border-top: 1px solid var(--line);
	}

	.topic-list a {
		display: grid;
		grid-template-columns: 170px 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
	}

	.topic-list a:hover span,
	.topic-list a:hover i {
		color: var(--accent);
	}

	.topic-list span {
		font-size: 0.86rem;
		font-weight: 600;
	}

	.topic-list small {
		color: var(--muted);
		font-size: 0.74rem;
	}

	.topic-list i {
		color: var(--muted);
		font-family: var(--font-mono);
		font-style: normal;
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-top: 3rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.metrics div {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1.15rem;
		border-right: 1px solid var(--line);
	}

	.metrics div:last-child {
		border-right: 0;
	}

	.metrics strong {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 1.25rem;
	}

	.metrics span {
		color: var(--muted);
		font-size: 0.7rem;
	}

	.research ol {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.research li {
		border-bottom: 1px solid var(--line);
	}

	.research li a {
		display: grid;
		gap: 0.25rem;
		padding: 0.9rem 0;
		color: var(--ink);
		text-decoration: none;
	}

	.research li a:hover strong {
		color: var(--accent);
	}

	.research li strong {
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.research li small {
		color: var(--muted);
		font-size: 0.68rem;
	}

	.path-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.path {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.75rem;
	}

	.path h2 {
		font-size: 1.45rem;
	}

	.path p {
		margin: 0;
		color: var(--muted);
		font-size: 0.88rem;
		flex: 1;
	}

	.path > i {
		font-style: normal;
		transition: color 0.15s var(--ease);
	}

	.path:hover h2,
	.path:hover > i {
		color: var(--accent);
	}

	.path-links {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	@media (max-width: 760px) {
		section {
			margin-bottom: 4.5rem;
		}

		.hero {
			padding-top: 2rem;
		}

		.hero h1 {
			font-size: clamp(2.8rem, 13vw, 4rem);
		}

		.work-grid,
		.research-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.metrics {
			grid-template-columns: repeat(2, 1fr);
		}

		.metrics div:nth-child(2) {
			border-right: 0;
		}

		.metrics div:nth-child(-n + 2) {
			border-bottom: 1px solid var(--line);
		}

		.path-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.topic-list a {
			grid-template-columns: 1fr auto;
		}

		.topic-list small {
			display: none;
		}
	}
</style>
